@page "/"
@attribute [StreamRendering]
@rendermode InteractiveServer
<PageTitle>Home</PageTitle>

@* De esta forma se puede manejar el evento OnClick sin necesidad de usar una función lambda, *@
<BPBoton id="mi-boton" name="mi-boton" class="p-3" OnClick="ManejarClick"/>
@* Pero si queremos pasar un mensaje personalizado al hacer click en el boton, entonces si es necesario usar una función lambda, como se muestra en el siguiente boton: *@
<BPBoton OnClick="@(()=>ManejarClick("Clikeaste el boton 2"))">Mi texto personalizado</BPBoton>

@* <BPBoton Variante="Variante.Advertencia" Tamaño="Tamaño.Lg"/>
<BPBoton Variante="Variante.Error" Tamaño="Tamaño.Sm"/>
<BPBoton Texto="Texto Personalizado" Disabled="true" Tipo="BotonTipo.Submit" Variante="Variante.Exitoso"/> *@

<hr />

@* Data binding basico (@bind)*@
<input type="checkbox" @bind="mostrarPeliculas" />
Mostrar películas

@if(mostrarPeliculas)
{
    <h3>En Cartelera</h3>
    <ListadoPeliculas Peliculas="enCartelera"/>

    <h3>Futuros Estrenos</h3>
    <ListadoPeliculas Peliculas="futurosEstrenos"/>    
}


@code {

    // protected override async Task OnInitializedAsync()
    // {

    // }

    private bool mostrarPeliculas = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(!firstRender)
        {
            return;
        }

        await Task.Delay(TimeSpan.FromSeconds(2));
        enCartelera = new List<Pelicula>
        {
             new Pelicula
             {
                 Id = 1,
                 Titulo = "Captain America: Brave New World",
                 FechaLanzamiento = new DateTime(2025,2,14)
             },
             new Pelicula
             {
                 Id = 2,
                 Titulo = "Mission: Impossible - Dead Reckoning Part two",
                 FechaLanzamiento = new DateTime(2025,5,23)
             }
        };

        futurosEstrenos = new List<Pelicula>
        {
             new Pelicula
             {
                 Id = 3,
                 Titulo = "Avengers: Secret Wars",
                 FechaLanzamiento = new DateTime(2027,5,7)
             },
             new Pelicula
             {
                 Id = 4,
                 Titulo = "The Batman - Part II",
                 FechaLanzamiento = new DateTime(2027,10,1)
             }
        };

        StateHasChanged();

    }

    private void ManejarClick()
    {
        Console.WriteLine("Evento desde el componente padre");
        mostrarPeliculas = !mostrarPeliculas;
    }

    private void ManejarClick(string mensaje) => Console.WriteLine(mensaje);

    private List<Pelicula>? enCartelera = null;
    private List<Pelicula>? futurosEstrenos = null;
}