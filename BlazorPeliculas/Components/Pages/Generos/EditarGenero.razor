@page "/generos/editar/{Id:int}"
@inject IServicioGeneros servicioGeneros
@inject NavigationManager navigationManager
@attribute [Authorize(Roles = "administrador")]

<h3>Editar Género</h3>

@if (genero is null)
{
    <Cargando />
}
else
{
    @* porque esto?: FormularioInvalido="false" porque si estoy editando un genero y 
    estoy tomando ese genero de la base de datos se puede entender que ese genero ya 
    fue validado por tanto el estado incial de este formulario es que no es invalido, 
    por lo tanto el valor inical es false  *@
    <FormularioGenero FormularioPosteadoConExito="formularioPosteadoConExito"
                      PosteoEnCurso="posteoEnCurso" FormularioInvalido="false"
                      OnValidSubmit="Editar" Genero="genero" />
}

@code {
    [Parameter] public int Id { get; set; }
    private Genero? genero = null;
    private bool formularioPosteadoConExito = false;
    private bool posteoEnCurso = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(!firstRender)
        {
            return;
        }

        genero = await servicioGeneros.ObtenerPorId(Id);

        if(genero is null)
        {
            navigationManager.NavigateTo("/generos");
        }

        StateHasChanged();// Permite que el UI se actualice después de obtener el género de la base de datos
    }

    private async Task Editar()
    {
        if (!posteoEnCurso)
        {
            posteoEnCurso = true;
            
            StateHasChanged();
            await Task.Yield(); // Permite que el UI se actualice antes de realizar la operación de base de datos

            await servicioGeneros.Actualizar(genero!);

            posteoEnCurso = false;
            formularioPosteadoConExito = true;
            StateHasChanged();
            navigationManager.NavigateTo("/generos");
        }
    }
}
