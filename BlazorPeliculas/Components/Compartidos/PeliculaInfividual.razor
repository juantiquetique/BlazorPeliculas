<p>Título:<b>@Pelicula.Titulo</b></p>
<BPBoton Variante="Variante.Error" OnClick="@(()=>EliminarPelicula.InvokeAsync(Pelicula))">Borrar</BPBoton>

<p>Fecha Lanzamiento: <b>@Pelicula.FechaLanzamiento.ToString("dd MMM yyyy")</b></p>

@code {
    // Parametros requeridos
    [Parameter, EditorRequired] public required Pelicula Pelicula { get; set; }
    [Parameter] public EventCallback<Pelicula> EliminarPelicula { get; set; }
}
