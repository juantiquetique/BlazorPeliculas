    // esto sabiendo que el componente ListadoPeliculas se va a reutilizar para mostrar diferentes listas de películas, y que es seguro que si tiene ==
    // [Parameter] public required List<Pelicula> Peliculas { get; set; }

    // acepta nulos, por eso el signo de interrogación después del tipo de dato List<Pelicula>?, 
    // lo que indica que la propiedad Peliculas puede ser nula.Esto es útil para manejar casos 
    // en los que no se han cargado las películas o no hay datos disponibles, permitiendo 
    // mostrar un mensaje de carga o un mensaje indicando que no hay películas para mostrar.

    // El EditorRequired es un atributo que se utiliza para indicar que la propiedad Peliculas es requerida en el editor de Blazor. 
    // Esto significa que cuando se utiliza el componente ListadoPeliculas en otro lugar, 
    // el editor de Blazor marcará esta propiedad como obligatoria y mostrará un error si no se proporciona un valor para ella.
    [Parameter, EditorRequired] public List<Pelicula>? Peliculas { get; set; }

    [Parameter] public RenderFragment? Cargando { get; set; } =@<Cargando/>;
    [Parameter] public RenderFragment? NoHayRegistros { get; set; } =@<text>No existen Películas para mostrar...</text>;

    private List<Pelicula> peliculas { get; set; } = null!;

    @* se crea la funciona a ejecutar mendiante la referencia a un componente para poder manipularlo facilmente*@
    public void LimpiarPeliculas() => peliculas?.Clear();

    protected override void OnInitialized()
    {
        peliculas = Peliculas!;
    }

    protected override void OnParametersSet()
    {
        peliculas = Peliculas!;
    }


    private async Task EliminarPelicula(Pelicula pelicula)
    {
        //esto es para invocar metodos de JavaScript desde Blazor, en este caso el método confirm para mostrar un cuadro de diálogo de confirmación al usuario antes de eliminar la película.
        // tambien se crea la clase IJSRuntimeExtensionMethods en BlazorPeliculas.Utilidades con el método Confirm para construir el mensaje de confirmación de manera más estructurada y reutilizable.
        var mensaje = $"¿Desea borrar la película {pelicula.Titulo}?";
        var confirmado = await JS.InvokeAsync<bool>("confirm", JS.Confirm(mensaje) );
        if (confirmado)
        {
            peliculas!.Remove(pelicula);
        }
    }
}
