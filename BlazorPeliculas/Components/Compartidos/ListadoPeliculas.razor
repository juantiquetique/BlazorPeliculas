@inject IJSRuntime JS

@* se atrapa el error con el componente ErrorBoundary, el cual es un componente de Blazor
que se utiliza para manejar errores de forma personalizada en la interfaz de usuario. *@
<ListadoGenerico Listado="peliculas">
    <ErrorBoundary>
        <ChildContent>                
            <PeliculaInfividual @key="context.Id" Pelicula="@context" EliminarPelicula="EliminarPelicula"/>
        </ChildContent>
        <ErrorContent Context="error">
            <hr />
                La pelicula no pudo ser cargada...
            <hr />
        </ErrorContent>
    </ErrorBoundary>
</ListadoGenerico>


