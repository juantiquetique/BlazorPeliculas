@using System.Linq.Expressions
<div class="mb-3">
    <label for="@Id">@Label:</label>
    <div>
        <InputText class="form-control" Value="@Value" ValueChanged="@ValueChanged" 
        ValueExpression="@ValueExpression" autocomplete="off" id = "@Id"/> 
        @* aqui van a salir los mensajes de validacion que correspondan segun el campo *@
        <ValidationMessage For="@ValueExpression" />
    </div>
</div>

@code {
    private string Id { get; set; } = Guid.NewGuid().ToString();
    [Parameter, EditorRequired] public string Label { get; set; }
    // El valor (value) es el valor que tiene la propiedad que quiero sincronizar con el input
    [Parameter] public string Value { get; set; } = null!;
    // el cambio del valor (ValueChaged) me permite reaccionar al cambio del valor del input y pasarle el nuevo valor al componente padre
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    // una expresion del valor del input (ValueExpresion) es el que permite indicar que campo del modelo estoy vinculando al input
    [Parameter] public Expression<Func<string>> ValueExpression  { get; set; } = null!;
}